{
  "name": "MFC Dev Container",
  "image": "mohdsaid497566/mfc:v4.4.1-cpu",
  "workspaceFolder": "/workspaces",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash",
    "editor.formatOnSave": true
